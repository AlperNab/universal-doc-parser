      "Export"
    ],
    "empty_state": "Upload a finance document or paste source text. The UI will keep live-data sections empty until real files/connectors are provided.",
    "icon": "💳",
    "project_slug": "universal-doc-parser",
    "domain": "Document AI / Finance Docs"
  },
  "final_gui_status": {
    "standalone_folder_gui": true,
    "domain_specific_ux_profile": true,
    "elegant_component_system": true,
    "no_fake_live_data_policy": true,
    "requires_real_connectors_for_external_actions": true
  }
