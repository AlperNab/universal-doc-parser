{
  "slug": "universal-doc-parser",
  "name": "Universal Doc Parser",
  "domain": "Document AI / Finance Docs",
  "target_user": "Domain operator, business owner, analyst, or team member who needs this workflow executed reliably.",
  "core_job": "Arbitrary financial docs → schema-mapped JSON",
  "deep_features": [
    "document type detection",
    "schema designer",
    "OCR/vision fallback",
    "confidence scoring",
    "human correction loop",
    "API mapping",
    "validation rules"
  ],
  "input_schema": [
    {
      "key": "arbitrary_financial_docs",
      "label": "Arbitrary financial docs",
      "type": "text",
      "required": true,
      "help": "Affects input: Arbitrary financial docs.",
      "affects": [
        "prompt",
        "workflow"
      ],
      "default": ""
    },
    {
      "key": "work_brief",
      "label": "Work brief / source text / URL / instructions",
      "type": "textarea",
      "required": true,
      "default": "",
      "help": "Paste the material, URL, description, or instruction needed for this project.",
      "affects": [
        "prompt",
        "workflow"
      ]
    }
  ],
  "customization_schema": [
    {
      "key": "execution_mode",
      "label": "Execution mode",
      "type": "select",
      "required": false,
      "options": [
        "Draft",
        "Production",
        "Audit / strict review",
        "JSON/API output"
      ],
      "default": "Production",
      "help": "Controls strictness, depth, and output format for this project workflow.",
      "affects": [
        "workflow",
        "validation",
        "export"
      ]
    },
    {
      "key": "document_class",
      "label": "document class",
      "type": "text",
      "required": false,
      "help": "Affects customization: document class.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "default": ""
    },
    {
      "key": "target_schema",
      "label": "target schema",
      "type": "select",
      "required": false,
      "help": "Affects customization: target schema.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "default": ""
    },
    {
      "key": "confidence_threshold",
      "label": "confidence threshold",
      "type": "slider",
      "required": false,
      "help": "Affects customization: confidence threshold.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "min": 0,
      "max": 100,
      "default": 50
    },
    {
      "key": "privacy_mode",
      "label": "privacy mode",
      "type": "select",
      "required": false,
      "help": "Affects customization: privacy mode.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "options": [
        "cloud allowed",
        "local only",
        "redact sensitive data"
      ],
      "default": "cloud allowed"
    },
    {
      "key": "extraction_provider",
      "label": "extraction provider",
      "type": "text",
      "required": false,
      "help": "Affects customization: extraction provider.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "default": ""
    },
    {
      "key": "review_workflow",
      "label": "review workflow",
      "type": "text",
      "required": false,
      "help": "Affects customization: review workflow.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "default": ""
    },
    {
      "key": "output_format",
      "label": "output format",
      "type": "select",
      "required": false,
      "help": "Affects customization: output format.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "options": [
        "Markdown",
        "JSON",
        "CSV",
        "PDF",
        "DOCX",
        "XLSX"
      ],
      "default": "Markdown"
    },
    {
      "key": "language",
      "label": "language",
      "type": "select",
      "required": false,
      "help": "Affects customization: language.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "options": [
        "English",
        "Arabic",
        "Egyptian Arabic",
        "French",
        "German",
        "Spanish"
      ],
      "default": "English"
    }
  ],
  "workflow_steps": [
    "Arbitrary financial docs",
    "schema-mapped JSON"
  ],
  "ui_panels": [
    "upload",
    "detected schema",
    "extracted fields",
    "evidence pane",
    "corrections",
    "export mapper"
  ],
  "output_formats": [
    "structured JSON",
    "CSV",
    "validation report",
    "API payload"
  ],
  "integrations": [
    "File upload",
    "REST API",
    "Export download",
    "Job history",
    "OCR vision optional"
  ],
  "guardrails": [
    "Show uncertainty and confidence",
    "Cite evidence from input when possible",
    "Human review required for legal, medical, financial, hiring, or security decisions",
    "Do not invent facts absent from input"
  ],
  "recommended_models": {
    "drafting": "fast cloud or local instruct model",
    "reasoning": "strong reasoning model",
    "private_documents": "local model via Ollama/LM Studio/vLLM",
    "vision_or_pdf": "vision-capable model when image pages are used"
  },
  "suite": "Finance Document Suite",
  "implementation_status": "real_local_engine_registered",
  "analysis_modules": [
    "doc_type_detect",
    "key_value_extract",
    "table_extract"
  ],
  "output_sections": [
    "Detected schema",
    "Key-values",
    "Tables",
    "Confidence gaps"
  ],
  "field_validations": [
    {
      "field": "target_schema",
      "rule": "Validate output keys against requested schema and include missing-key warnings."
    },
    {
      "field": "language",
      "rule": "Preserve requested language in final deliverable unless source text requires bilingual output."
    }
  ],
  "scorecards": [
    "Extraction confidence",
    "Reconciliation status",
    "Tax/currency risk",
    "Duplicate risk",
    "Export readiness"
  ],
  "automation_hooks": [
    {
      "name": "save_job_snapshot",
      "type": "internal",
      "description": "Persist inputs, customization, uploads, output, and usage for audit/history."
    },
    {
      "name": "export_pack",
      "type": "internal",
      "description": "Export Markdown, JSON, PDF, and DOCX from the completed job."
    },
    {
      "name": "human_review_queue",
      "type": "manual",
      "description": "Flag low-confidence, legal/medical/finance/security/compliance-sensitive items for human review."
    }
  ],
  "ux_profile": {
    "name": "Finance Ops Console",
    "accent": "#67e8f9",
    "layout": "Document intake → extraction → validation → approval/export",
    "hero": "Audit-ready finance workflow with line-item review, validation ledger, exception handling, and export controls.",
    "components": [
      "Document intake panel",
      "Extraction table",
      "Validation ledger",
      "Approval checklist",
      "Export connector cards"
    ],
    "metrics": [
      "Extraction confidence",
